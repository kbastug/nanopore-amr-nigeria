# Assembly-level Kraken2 analysis

#!/bin/bash
#SBATCH --job-name=kraken2_example
#SBATCH --output=kraken2_%j.out
#SBATCH --error=kraken2_%j.err
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=120G
#SBATCH --partition=msismall

# Example Kraken2 workflow used on MSI
# Kraken2 version: 2.17.1
# Database: PlusPF, built May 17, 2021

DB="/path/to/kraken2_db"
OUTDIR="/path/to/kraken2_output"

mkdir -p "$OUTDIR"

kraken2 \
  --db "$DB" \
  --threads 8 \
  --use-names \
  --report "$OUTDIR/sample.kraken2.report.txt" \
  --output "$OUTDIR/sample.kraken2.output.txt" \
  sample.fasta


# Individual-contig Kraken2 analysis
# Used when assembly results suggested more than one bacterial taxon.

kraken2 \
  --db "$DB" \
  --threads 8 \
  --use-names \
  --report "$OUTDIR/contig_1.kraken2.report.txt" \
  --output "$OUTDIR/contig_1.kraken2.output.txt" \
  assembly_contig_1.fasta

kraken2 \
  --db "$DB" \
  --threads 8 \
  --use-names \
  --report "$OUTDIR/contig_2.kraken2.report.txt" \
  --output "$OUTDIR/contig_2.kraken2.output.txt" \
  assembly_contig_2.fasta
